# ─── CareerSetu Frontend — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# All variables MUST start with VITE_ to be accessible in the browser.

# Backend base URL (no trailing slash, no /api suffix — the service layer adds /api)
# In development the vite proxy forwards /api/* to localhost:8080
# For production, set this to your deployed backend URL:
VITE_API_BASE_URL=http://localhost:8080/api

# Razorpay public key (safe to expose — it's the KEY ID, not the secret)
# Get from https://dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
