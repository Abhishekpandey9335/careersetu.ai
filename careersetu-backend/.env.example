# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/careersetu
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) for HS256
JWT_SECRET=careersetu-super-secret-jwt-key-change-this-in-production!!

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: grok | openai
AI_PROVIDER=grok
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password    # Use Gmail App Password, not account password

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://careersetu.in
